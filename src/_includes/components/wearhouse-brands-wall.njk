<section class="relative overflow-hidden bg-[#FAF8F6] text-ink">
  <div class="relative mx-auto w-full max-w-[1600px] px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="mb-12 flex flex-col gap-6 border-t border-black/10 pt-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-[38rem]">
        <p class="type-eyebrow mb-4 text-black/40" data-reveal data-cms-bind="homepage.wearhouse-portfolio#wearhouseWall.eyebrow">
          {{ cms.home.wearhouseWall.eyebrow }}
        </p>
        <h2 class="type-section-title max-w-[15ch] text-black" data-reveal data-cms-bind="homepage.wearhouse-portfolio#wearhouseWall.title">
          {{ cms.home.wearhouseWall.title }}
        </h2>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {% for brand in wearhouse.brands %}
        {% set logoClass = 'h-10 sm:h-12 lg:h-14 w-auto max-w-[12rem] object-contain object-left' %}
        {% set bodyClass = 'type-body-sm max-w-[24rem]' %}
        {% set imageClass = 'object-center' %}
        {% set cardImage = brand.detailHeroImage or brand.hoverImage %}
        {% set logoImage = brand.logoSrc or brand.logoSvg %}
        <a href="{{ brand.pageHref }}" class="group relative block min-h-[24rem] overflow-hidden border border-black/5 bg-[#FAF7F4]" data-reveal>
          {% if cardImage %}
            <img src="{{ cardImage }}" alt="{{ brand.name }} image" class="absolute inset-0 h-full w-full object-cover {{ imageClass }} transition duration-[1100ms] group-hover:scale-[1.04] group-hover:opacity-92">
          {% endif %}
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.22),rgba(0,0,0,0.34)_28%,rgba(0,0,0,0.86)_100%)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.08),transparent_34%),linear-gradient(180deg,rgba(0,0,0,0.08),rgba(0,0,0,0)_30%,rgba(0,0,0,0.24)_100%)] opacity-90"></div>
          <div class="relative flex h-full flex-col justify-between p-6 lg:p-7">
            <div class="flex items-start justify-between gap-4">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/16 bg-white/10 text-sm text-white/72 transition duration-300 group-hover:bg-white group-hover:text-black">→</span>
            </div>
            <div class="max-w-[28rem]">
              {% if brand.cardLabel %}<p class="type-label mb-3 text-white/80">{{ brand.cardLabel }}</p>{% endif %}
              <div class="mb-4 flex max-w-full items-center">
                {% if logoImage %}
                  <img src="{{ logoImage }}" alt="{{ brand.name }}" class="block brightness-0 invert drop-shadow-[0_8px_22px_rgba(0,0,0,0.38)] {{ logoClass }}">
                {% else %}
                  <span class="font-display text-[2rem] leading-none tracking-[-0.04em] text-white drop-shadow-[0_8px_22px_rgba(0,0,0,0.38)]">{{ brand.name }}</span>
                {% endif %}
              </div>
              <p class="text-white {{ bodyClass }}">{{ brand.summary }}</p>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
